# HTTPS in front of nginx (docker-compose.https.yml). Caddy gets and renews the Let's Encrypt
# certificate for SITE_DOMAIN by itself (ports 80 and 443 must be open) and redirects http to https.
{$SITE_DOMAIN} {
	encode gzip

	# Browsers remember to use https only (one year).
	header Strict-Transport-Security "max-age=31536000"

	# Uploads: a bit above the video limit, like nginx (deploy/nginx.conf).
	request_body {
		max_size 330MB
	}

	# Adds X-Forwarded-For / X-Forwarded-Proto; nginx passes the visitor's address on to Django.
	reverse_proxy nginx:80 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
