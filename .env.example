# Copy to .env on the server and fill in. Never commit .env.

# Generate with:  openssl rand -base64 48
DJANGO_SECRET_KEY=change-me

# Every name/IP staff use to open the site, comma-separated.
DJANGO_ALLOWED_HOSTS=info.company.local,10.0.0.15
DJANGO_CSRF_TRUSTED_ORIGINS=http://info.company.local,http://10.0.0.15

# Internet with HTTPS (docker-compose.https.yml): the domain Caddy gets the certificate for.
# SITE_DOMAIN=infohub-demo.duckdns.org

# 1 = the site is reached over HTTPS (login cookies only travel encrypted).
# 0 = plain http, e.g. inside the VPN without a certificate.
DJANGO_HTTPS=0

# Used in links inside admin e-mails.
WAGTAILADMIN_BASE_URL=http://info.company.local

POSTGRES_DB=infohub
POSTGRES_USER=infohub
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional: also write server errors to this file (rotated at 5 MB). For shared hosting, a path
# outside public_html. Docker keeps them anyway: docker compose logs web
# INFOHUB_LOG_FILE=/home/<user>/infohub-logs/errors.log
